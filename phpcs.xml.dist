<?xml version="1.0"?>
<ruleset name="MacPaw Symfony Packages Template">
    <description>PHP_CodeSniffer configuration for Symfony packages</description>
    
    <file>src</file>
    <file>tests</file>
    
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/var/*</exclude-pattern>
    <exclude-pattern>*/cache/*</exclude-pattern>
    <exclude-pattern>*.phpunit.result.cache</exclude-pattern>
    
    <rule ref="PSR12"/>
</ruleset>

