{
    "name": "macpaw/symfony-packages-template",
    "description": "Boilerplate template for Symfony packages",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "MacPaw",
            "email": "opensource@macpaw.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/http-kernel": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.48",
        "infection/infection": "^0.31.9",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.2",
        "squizlabs/php_codesniffer": "^3.7",
        "symfony/phpunit-bridge": "^6.4|^7.0"
    },
    "autoload": {
        "psr-4": {
            "MacPaw\\SymfonyPackagesTemplate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MacPaw\\SymfonyPackagesTemplate\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true,
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
